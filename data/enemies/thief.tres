[gd_resource type="Resource" script_class="EnemyData" format=3]
[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/enemies/rendered/thief_m43.png" id="art"]
[ext_resource type="Texture2D" path="res://assets/sprites/enemies/rendered/thief_m43_walk.png" id="walk"]
[resource]
script = ExtResource("script")
id = &"thief"
display_name = "Ladrón"
description = "Roba 3 de oro cada 2 segundos mientras sigue en pantalla, sin bajar de 10. Si ganás monedas, vuelve a robar. Matalo pronto; escapar no añade otro robo."
max_health = 24
speed_tiles = 1.6
reward = 6
lives_damage = 1
size_tiles = 0.3
color = Color(0.58, 0.48, 0.72, 1)
texture = ExtResource("art")
gold_drain_amount = 3
gold_drain_interval = 2.0
gold_drain_floor = 10
optional_wave_limit = 1

walk_atlas = ExtResource("walk")
walk_stride_tiles = 0.65
walk_art_scale = 1.0
visual_scale = 1.2
flip_when_walking_left = false
