[resource]
script = ExtResource("tower")
id = &"mechanical_standard"
display_name = "Estandarte mecánico"
description = "Estatua de ingeniería: aumenta la cadencia de los cañones cercanos. No dispara ni acumula su apoyo con otros estandartes. Requiere cinco avances y permiso del nivel. Reparación en una etapa posterior."
color = Color(0.68, 0.78, 0.83, 1)
reserved = true
support_only = true
required_collection = &"technology"
turret_texture = ExtResource("statue")
levels = Array[ExtResource("stats")]([SubResource("level1"), SubResource("level2"), SubResource("level3")])
