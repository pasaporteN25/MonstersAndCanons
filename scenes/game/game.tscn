[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/game/game.gd" id="1_game"]
[ext_resource type="Resource" path="res://data/levels/level_01.tres" id="2_level"]
[ext_resource type="Resource" path="res://data/balance.tres" id="3_balance"]
[ext_resource type="Resource" path="res://data/towers/basic.tres" id="4_basic"]
[ext_resource type="Resource" path="res://data/towers/cannon.tres" id="5_cannon"]
[ext_resource type="Resource" path="res://data/towers/frost.tres" id="6_frost"]
[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="7_tower_data"]
[ext_resource type="Script" path="res://scenes/game/build_controller.gd" id="8_build"]
[ext_resource type="Script" path="res://scenes/game/wave_spawner.gd" id="9_spawner"]
[ext_resource type="Script" path="res://scenes/game/level_session.gd" id="10_session"]
[ext_resource type="PackedScene" path="res://scenes/game/hud.tscn" id="11_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/end_screen.tscn" id="12_end"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")
level_data = ExtResource("2_level")
balance = ExtResource("3_balance")
tower_types = Array[ExtResource("7_tower_data")]([ExtResource("4_basic"), ExtResource("5_cannon"), ExtResource("6_frost")])

[node name="Towers" type="Node2D" parent="."]

[node name="Enemies" type="Node2D" parent="."]

[node name="Projectiles" type="Node2D" parent="."]

[node name="BuildController" type="Node2D" parent="."]
script = ExtResource("8_build")

[node name="WaveSpawner" type="Node" parent="."]
script = ExtResource("9_spawner")

[node name="Session" type="Node" parent="."]
script = ExtResource("10_session")

[node name="HUD" parent="." instance=ExtResource("11_hud")]

[node name="EndScreen" parent="." instance=ExtResource("12_end")]
